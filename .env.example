# ---- GameKeepr ---------------------------------------------------------------
# Copy to .env and fill in. Every value is validated at boot; the portal refuses
# to start with a clear message rather than running half-configured.
#
# There are no accounts in here. The first one is created through a setup page
# using a token printed to the container log, and that account is the owner.


# === Required ================================================================

# The address people will type. It decides whether session cookies are marked
# Secure, so once you are behind HTTPS this must say https.
PUBLIC_URL=https://portal.example.com

# Signing key for session cookies, and the key that encrypts every stored
# integration credential (router, Cloudflare Access, VirusTotal, Discord
# webhook, Steam Web API key). Generate with:  openssl rand -hex 32
# Changing it signs everyone out and makes those stored credentials
# unreadable — they must be entered again.
SESSION_SECRET=


# === Where things live =======================================================

PORT=8080

# Both are paths inside the container; see docker-compose.yml for the mounts.
DATABASE_PATH=/data/gamekeep.db
CONFIG_PATH=/config/servers.json

# Newly deployed game servers get a folder here. Two views of one directory:
#   APPDATA_ROOT      - as the portal container sees it, used to create folders
#   APPDATA_HOST_ROOT - the same directory as the HOST sees it
# Docker resolves bind mounts against the host, so getting the second one wrong
# silently writes game data somewhere else entirely.
#   Unraid:  /mnt/cache/appdata  or a dedicated share
#   Generic: /srv/gameservers
APPDATA_ROOT=/gameservers
APPDATA_HOST_ROOT=/srv/gameservers


# === Docker ==================================================================

# How the portal reaches Docker. Leave as-is for a plain socket mount.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Alternative to the socket: a docker-socket-proxy that exposes only what is
# needed. See "Optional hardening" in the README. Setting this ignores
# DOCKER_SOCKET_PATH.
#DOCKER_HOST=http://dockerproxy:2375


# Schedules run on this clock: a nightly restart at 05:00 means YOUR 05:00.
TZ=Europe/Brussels

# Where world backups land. Inside the data volume by default, so they survive
# game containers being recreated and ride along with your appdata backups.
#BACKUP_DIR=/data/backups


# === Optional ================================================================

# This machine's address on your LAN. Port forwards point here, because the
# router forwards to the host and not to a container. Without it the portal
# still lists which ports a server needs, it just cannot name a destination.
LAN_ADDRESS=

# Unraid only: where container templates live. Mounting it makes servers that
# the portal deploys appear properly in Unraid's Docker tab. On any other host
# leave it unmounted and the step is skipped.
UNRAID_TEMPLATE_DIR=/unraid-templates

# The Docker network deployed game servers join. The portal creates it and
# joins it itself on the first deploy, so there is nothing to set up.
#
# Not the default bridge: containers there cannot resolve each other by name,
# so the portal would have to reach a game server through the host's own
# address instead of directly. And separate from the portal's own network by
# default, because Docker isolates bridge networks from one another — which
# keeps a game server, running whatever mod code you install, away from a
# tunnel or reverse proxy sitting beside the portal.
#
# Set this to the portal's own network instead if you would rather keep
# everything together and can live with that.
GAME_NETWORK=gamekeep-servers

# Which publishers deploy from the Community Applications catalogue without a
# warning, and whose images validation runs may execute unattended. Everyone
# else still shows in the catalogue and deploys past an explicit warning the
# operator acknowledges. Comma-separated; unset uses the built-in default of
# the well-known game-server maintainers.
#TRUSTED_PUBLISHERS=ich777,binhex,linuxserver

# Which sources may set X-Forwarded-For, as comma-separated CIDRs. This decides
# what the audit log records as the visitor's address. The default trusts the
# Docker bridge range, where a reverse proxy or cloudflared sits, plus loopback.
# Trusting everything would let any client claim any address, including a LAN
# one -- so widen this deliberately or not at all.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

NODE_ENV=production

# Development only: the Vite dev server origin allowed through CORS.
#DEV_ORIGIN=http://localhost:5173

# Where the opt-in anonymous usage ping goes. Statistics are OFF by default
# and the owner turns them on in Settings after reading the exact payload —
# this only decides the destination, and it already points at the project's
# own open-source receiver (see mothership/), so leave this line commented out
# unless you run your own.
#
# Setting it to an EMPTY value silences the build completely: nothing is sent
# even after opting in, and the Settings card says so rather than pretending.
#TELEMETRY_ENDPOINT=
